<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:statusBarColor">#143D2C</item>
        <item name="android:navigationBarColor">#F4F7F5</item>
        <item name="android:windowBackground">#F4F7F5</item>
    </style>
    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#143D2C</item>
    </style>
    <style name="CardType">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#5C6B64</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="CardValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#143D2C</item>
    </style>
    <style name="StepCounterValue" parent="CardValue">
        <item name="android:textColor">#128A3A</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CardMeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#3E4A45</item>
        <item name="android:paddingTop">2dp</item>
    </style>
</resources>
