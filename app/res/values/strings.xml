    <string name="reset_credit">强制重置自动累加</string>
    <string name="reset_credit_title">重置自动累加</string>
    <string name="reset_credit_body">自动累加清零。送出值变成当前真实步数加 0，之后真实步数增加，送出值跟着增加。目标和上限不变。</string>
    <string name="reset_credit_done">已重置。送出值等于当前真实步数</string>
